# Copy to .env and adjust before running `docker compose up`.
POSTGRES_DB=nepse_portfolio
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000
ML_PORT=8000

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-development-secret

CORS_ORIGINS=*

SCRAPER_ENABLED=true
SCRAPER_INTERVAL_MS=90000
# Set true only for local demos outside NEPSE hours.

# Live quote providers, tried in order until one succeeds.
# nepse        = NEPSE's own API (primary)
# sharesansar  = HTML scrape (fallback)
MARKET_PROVIDERS=nepse,sharesansar
MARKET_TRADING_DAYS=MON,TUE,WED,THU,FRI
NEPSE_ENABLED=true
# Import NEPSE's full security universe on startup (set false for offline demos).
NEPSE_UNIVERSE_ON_STARTUP=true

# Real history import (socrateai-official/nepse-open-data, MIT).
HISTORY_BACKFILL_BASE_URL=https://raw.githubusercontent.com/socrateai-official/nepse-open-data/main
HISTORY_BACKFILL_AUTO=true
HISTORY_BACKFILL_DAYS=260

ML_ENABLED=true
# Minimum ML probability before it overrides the rule engine (0-1).
ML_MIN_CONFIDENCE=0.35

SEED_DEMO_USER=true

# Optional SMTP. Leave blank to just store contact messages in Postgres.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
ADMIN_EMAIL=
MAIL_FROM=no-reply@nepse.local
